{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naute",
  "version": "0.1.0",
  "identifier": "dev.kurodaki.naute",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../ui", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Naute",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#F4F3EE"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kurodaki",
    "copyright": "© 2026 Kurodaki. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Notes, sheets, designs and slides with private dictation",
    "longDescription": "Naute is a notes and design app: rich notes, spreadsheets, free-size designs and slide decks, with speech-to-text that runs entirely on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["naute"], "name": "Naute document", "description": "Naute document", "role": "Editor", "mimeType": "application/x-naute" }
    ],
    "macOS": { "minimumSystemVersion": "11.0", "infoPlist": "Info.plist" },
    "android": { "minSdkVersion": 26 }
  }
}
